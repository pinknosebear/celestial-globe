---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Celestial Globe</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;1,300&display=swap" rel="stylesheet" />
  </head>
  <body>
    <canvas id="globe-canvas"></canvas>

    <!-- Hamburger Menu (top-left) -->
    <button id="menu-hamburger" class="menu-hamburger" aria-label="Open menu">☰</button>
    <nav id="menu-dropdown" class="menu-dropdown hidden">
      <button class="menu-dropdown__item" data-panel="date-location">Date & Location</button>
      <button class="menu-dropdown__item" data-panel="display">Display Settings</button>
      <button class="menu-dropdown__item" data-panel="catalog">Catalog</button>
    </nav>

    <!-- Backdrop (covers canvas when panel open) -->
    <div id="panel-backdrop" class="panel-backdrop"></div>

    <!-- Panel: Date & Location -->
    <aside id="panel-date-location" class="sky-panel hidden">
      <button class="sky-panel__close" aria-label="Close panel">×</button>
      <div class="sky-panel__header">
        <h1>Date & Location</h1>
        <p id="sky-summary">San Francisco, CA · April 26, 2026 · 9:00 PM · UTC-07:00</p>
      </div>
      <form id="sky-controls" class="sky-form">
        <label>
          <span>Place</span>
          <input id="place-name" name="placeName" type="text" value="San Francisco, CA" />
        </label>
        <div class="sky-form__actions">
          <button id="search-place" type="button">Find Place</button>
          <button id="use-my-location" type="button">Use My Location</button>
        </div>
        <div id="place-results" class="place-results" aria-live="polite"></div>
        <div class="sky-form__meta">
          <p id="location-status">Resolved from place search</p>
          <p id="location-details">37.7749, -122.4194 · America/Los_Angeles · 16 m</p>
        </div>
        <div class="sky-form__row">
          <label>
            <span>Date</span>
            <input id="sky-date" name="date" type="date" value="2026-04-26" />
          </label>
          <label>
            <span>Time</span>
            <input id="sky-time" name="time" type="time" value="21:00" />
          </label>
        </div>
        <div class="sky-form__row sky-form__row--narrow">
          <label>
            <span>Elevation (m)</span>
            <input id="elevation" name="elevation" type="number" step="1" value="16" />
          </label>
        </div>
        <label class="sky-form__checkbox">
          <input id="enable-rotation" name="enableRotation" type="checkbox" checked />
          <span>Auto-rotate globe at distance</span>
        </label>
        <button type="submit">Update Sky</button>
      </form>
    </aside>

    <!-- Panel: Display Settings -->
    <aside id="panel-display" class="sky-panel hidden">
      <button class="sky-panel__close" aria-label="Close panel">×</button>
      <div class="sky-panel__header">
        <h1>Display Settings</h1>
      </div>
      <div class="sky-form">
        <label class="sky-form__checkbox">
          <input id="toggle-graticule" type="checkbox" checked />
          <span>Graticule</span>
        </label>
        <label class="sky-form__checkbox">
          <input id="toggle-equator" type="checkbox" checked />
          <span>Equator</span>
        </label>
        <label class="sky-form__checkbox">
          <input id="toggle-constellations" type="checkbox" checked />
          <span>Zodiac Lines</span>
        </label>
        <label class="sky-form__checkbox">
          <input id="toggle-zodiac-stars" type="checkbox" checked />
          <span>Zodiac Stars</span>
        </label>
        <label class="sky-form__checkbox">
          <input id="toggle-reference-planes" type="checkbox" checked />
          <span>Reference Planes</span>
        </label>
      </div>
    </aside>

    <!-- Panel: Catalog -->
    <aside id="panel-catalog" class="sky-panel hidden">
      <button class="sky-panel__close" aria-label="Close panel">×</button>
      <div class="sky-panel__header">
        <h1>Catalog</h1>
      </div>
      <div class="sky-form">
        <label class="sky-form__checkbox">
          <input type="checkbox" checked disabled />
          <span>Zodiac Constellations</span>
        </label>
        <label class="sky-form__checkbox">
          <input type="checkbox" checked disabled />
          <span>Solar System Bodies</span>
        </label>
      </div>
    </aside>

    <div id="labels" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;"></div>

    <script>
      import '../scripts/app.ts';

      // Menu and panel management
      const hamburger = document.getElementById('menu-hamburger') as HTMLButtonElement;
      const menuDropdown = document.getElementById('menu-dropdown') as HTMLElement;
      const backdrop = document.getElementById('panel-backdrop') as HTMLElement;
      const menuItems = document.querySelectorAll('.menu-dropdown__item') as NodeListOf<HTMLButtonElement>;

      let currentPanel: HTMLElement | null = null;

      function closeMenu() {
        menuDropdown.classList.add('hidden');
      }

      function openPanel(panelId: string) {
        // Close current panel if any
        if (currentPanel) {
          currentPanel.classList.add('hidden');
        }

        // Open new panel
        const panel = document.getElementById(`panel-${panelId}`) as HTMLElement;
        if (panel) {
          panel.classList.remove('hidden');
          currentPanel = panel;
          backdrop.classList.add('visible');
        }

        closeMenu();
      }

      function closePanel() {
        if (currentPanel) {
          currentPanel.classList.add('hidden');
          currentPanel = null;
        }
        backdrop.classList.remove('visible');
      }

      // Hamburger menu toggle
      hamburger.addEventListener('click', () => {
        menuDropdown.classList.toggle('hidden');
      });

      // Menu item click handlers
      menuItems.forEach(item => {
        item.addEventListener('click', () => {
          const panelId = item.getAttribute('data-panel');
          if (panelId) {
            openPanel(panelId);
          }
        });
      });

      // Close buttons on panels
      const closeButtons = document.querySelectorAll('.sky-panel__close') as NodeListOf<HTMLButtonElement>;
      closeButtons.forEach(btn => {
        btn.addEventListener('click', closePanel);
      });

      // Backdrop click to close
      backdrop.addEventListener('click', closePanel);

      // Close menu when clicking outside
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.closest('#menu-hamburger') && !target.closest('#menu-dropdown')) {
          closeMenu();
        }
      });
    </script>
  </body>
</html>
